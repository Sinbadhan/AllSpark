# MANIFEST.in
#
# Controls which auxiliary files are included in the source distribution
# (sdist) built by `python -m build`. Without this file, setuptools
# default-includes top-level project files plus the `tests/` tree
# regardless of `.gitignore`.
#
# Policy for v1.0:
#   - Include the public-facing project documents.
#   - Exclude the test suite (kept internal per README) and any local
#     .bak / .orig artefacts.
#   - Exclude maintainer-only status documents that are git-ignored.

include LICENSE
include README.md
include README_CN.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include CODE_OF_CONDUCT.md

recursive-include allspark *.py *.yaml *.yml *.html *.j2 py.typed
recursive-include docs *.md

prune tests
prune .github
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache

global-exclude *.bak
global-exclude *.orig
global-exclude *.py[cod]
global-exclude .DS_Store
